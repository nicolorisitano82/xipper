          }
        }
      }
    },
    "Una sola versione: ogni modifica ne aggiunge una, e quelle precedenti restano consultabili." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eine Version: Jede Änderung fügt eine hinzu, frühere bleiben abrufbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one version: every change adds one, and the earlier ones stay available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola versión: cada cambio añade una, y las anteriores siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule version : chaque modification en ajoute une, et les précédentes restent consultables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョンは1つだけです。変更するたびに1つ増え、以前のバージョンも参照できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有一个版本：每次更改都会新增一个版本，之前的版本仍可查看。"
          }
        }
      }
    },
