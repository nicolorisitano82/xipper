    "Conservala o salvala nel Portachiavi: senza di lei l'archivio non si apre." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre es sicher auf oder sichere es im Schlüsselbund: Ohne es kann das Archiv nicht geöffnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it safe or save it in the Keychain: without it the archive cannot be opened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdala en un lugar seguro o en el Llavero: sin ella el archivo comprimido no se puede abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez-le ou enregistrez-le dans le trousseau : sans lui, l'archive ne peut pas être ouverte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全に保管するか、キーチェーンに保存してください。これがないとアーカイブを開けません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请妥善保管或将其存储在“钥匙串”中：没有它就无法打开归档。"
          }
        }
      }
    },
