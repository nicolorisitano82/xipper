    "Controlla l'integrità dell'archivio senza estrarlo. Restituisce Sì se è integro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die Integrität des Archivs, ohne es zu entpacken. Gibt „Ja“ zurück, wenn es intakt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the archive's integrity without extracting it. Returns Yes if it is intact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la integridad del archivo comprimido sin extraerlo. Devuelve Sí si está íntegro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie l'intégrité de l'archive sans l'extraire. Renvoie Oui si elle est intacte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブを展開せずに整合性を確認します。破損していなければ「はい」を返します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查归档的完整性而不解压。如果完好则返回“是”。"
          }
        }
      }
    },
