    "Ci sono dati di recupero PAR2: «Ripara» ricostruisce le parti danneggiate, se il danno non supera la ridondanza." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PAR2-Wiederherstellungsdaten sind verfügbar: „Reparieren“ stellt die beschädigten Teile wieder her, sofern der Schaden die Redundanz nicht übersteigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PAR2 recovery data is available: Repair rebuilds the damaged parts, as long as the damage does not exceed the redundancy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay datos de recuperación PAR2: «Reparar» reconstruye las partes dañadas, siempre que el daño no supere la redundancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données de récupération PAR2 sont disponibles : « Réparer » reconstruit les parties endommagées, tant que les dégâts ne dépassent pas la redondance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PAR2リカバリデータがあります：損傷が冗長性を超えていなければ、「修復」で損傷した部分を再構築できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在 PAR2 恢复数据：只要损坏程度不超过冗余量，“修复”即可重建损坏的部分。"
          }
        }
      }
    },
