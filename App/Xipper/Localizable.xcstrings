            "value" : "Double-clicking ZIP, 7z, tar, gz, xz, zst and BGZF opens Xipper instead of Archive Utility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer doble clic en ZIP, 7z, tar, gz, xz, zst y BGZF se abre Xipper en lugar de la Utilidad de Archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
