    "Contiene caratteri che invertono la fine del nome: l'estensione che vedi non è quella vera." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält Zeichen, die das Namensende umkehren: Die angezeigte Erweiterung ist nicht die echte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contains characters that reverse the end of the name: the extension you see is not the real one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene caracteres que invierten el final del nombre: la extensión que ves no es la real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contient des caractères qui inversent la fin du nom : l'extension affichée n'est pas la vraie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前の末尾を反転させる文字が含まれています：表示されている拡張子は本当の拡張子ではありません。"
          }
