    "Archivi circa 10% più piccoli su programmi e codice sorgente, ma più lenti da aprire. Si leggono solo con Xipper 2.6 o successivo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 10 % kleinere Archive für Apps und Quellcode, aber langsamer beim Öffnen. Nur Xipper 2.6 oder neuer kann sie lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives about 10% smaller for apps and source code, but slower to open. Only Xipper 2.6 or later can read them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos comprimidos un 10% más pequeños en apps y código fuente, pero más lentos de abrir. Solo se pueden leer con Xipper 2.6 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives environ 10 % plus petites pour les apps et le code source, mais plus lentes à ouvrir. Seul Xipper 2.6 ou ultérieur peut les lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリやソースコードではアーカイブが約10%小さくなりますが、開くのに時間がかかります。読み込めるのはXipper 2.6以降のみです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于应用和源代码，归档大约小 10%，但打开速度较慢。仅 Xipper 2.6 或更高版本可以读取。"
          }
        }
      }
    },
