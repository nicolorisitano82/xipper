    "%@ sarà cifrato con AES-256. Senza la password nessuno potrà aprirlo, nemmeno tu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird mit AES-256 verschlüsselt. Ohne das Passwort kann es niemand öffnen, auch du nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be encrypted with AES-256. Without the password nobody can open it, not even you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cifrará con AES-256. Sin la contraseña nadie podrá abrirlo, ni siquiera tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera chiffré avec AES-256. Sans le mot de passe, personne ne pourra l'ouvrir, pas même vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はAES-256で暗号化されます。パスワードがないと、あなた自身も含め誰も開けません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将使用 AES-256 加密。没有密码，任何人都无法打开它，包括你自己。"
          }
        }
      }
    },
    "%@ sarà cifrato con ZipCrypto. Senza la password nessuno potrà aprirlo, nemmeno tu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird mit ZipCrypto verschlüsselt. Ohne das Passwort kann es niemand öffnen, auch du nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be encrypted with ZipCrypto. Without the password nobody can open it, not even you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cifrará con ZipCrypto. Sin la contraseña nadie podrá abrirlo, ni siquiera tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
