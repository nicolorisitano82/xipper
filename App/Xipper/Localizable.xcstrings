    "“Mantieni entrambi” salva la copia come “%@”. Sostituisci sposta il file sul disco nel Cestino." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Beide behalten“ sichert die Kopie als „%@“. „Ersetzen“ legt die Datei auf der Festplatte in den Papierkorb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Keep Both” saves the copy as “%@”. Replace moves the file on disk to the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Conservar ambos» guarda la copia como «%@». «Reemplazar» traslada el archivo del disco a la Papelera."
          }
        },
        "fr" : {
