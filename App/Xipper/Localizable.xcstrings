            "state" : "translated",
            "value" : "« Conserver les deux » enregistre la copie sous « %@ ». « Remplacer » place le fichier du disque dans la corbeille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「両方を残す」を選ぶとコピーが「%@」として保存されます。「置き換える」を選ぶとディスク上のファイルがゴミ箱に移動されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
