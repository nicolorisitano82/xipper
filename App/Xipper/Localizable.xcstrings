    "Cerca nell'archivio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiv durchsuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search Archive"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar en el archivo comprimido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher dans l'archive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ内を検索"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索归档"
          }
        }
      }
    },
    "Chi ha questo file può aprire gli archivi destinati a te o firmare al posto tuo. Tienilo in un posto sicuro e non mandarlo per email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer diese Datei hat, kann für dich bestimmte Archive öffnen oder in deinem Namen signieren. Bewahre sie sicher auf und versende sie nicht per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever has this file can open archives meant for you or sign in your name. Keep it somewhere safe and do not email it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga este archivo podrá abrir los archivos comprimidos destinados a ti o firmar en tu nombre. Guárdalo en un lugar seguro y no lo envíes por correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque possède ce fichier peut ouvrir les archives qui vous sont destinées ou signer à votre place. Conservez-le en lieu sûr et ne l'envoyez pas par e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルを持っている人は、あなた宛てのアーカイブを開いたり、あなたの名前で署名したりできます。安全な場所に保管し、メールで送らないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拥有此文件的人可以打开发给你的归档，或以你的名义签名。请将其存放在安全的地方，不要通过电子邮件发送。"
          }
        }
      }
    },
    "Chi possiede anche uno solo dei file in chiaro (per esempio un PDF già inviato per email) può ricavare la chiave e aprire tutto l'archivio in pochi minuti." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer auch nur eine der Dateien unverschlüsselt hat (zum Beispiel ein bereits per E-Mail gesendetes PDF), kann den Schlüssel wiederherstellen und das ganze Archiv in wenigen Minuten öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who has even one of the files unencrypted (for example a PDF already sent by email) can recover the key and open the whole archive in minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga aunque sea uno de los archivos sin cifrar (por ejemplo, un PDF ya enviado por correo electrónico) puede obtener la clave y abrir todo el archivo comprimido en pocos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque possède ne serait-ce qu'un des fichiers non chiffrés (par exemple un PDF déjà envoyé par e-mail) peut retrouver la clé et ouvrir toute l'archive en quelques minutes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていないファイルを1つでも持っている人（たとえば、すでにメールで送ったPDF）は、数分で鍵を復元してアーカイブ全体を開くことができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要有人拥有其中任意一个未加密的文件（例如已通过电子邮件发送的 PDF），就能在几分钟内恢复密钥并打开整个归档。"
          }
        }
      }
    },
    "Chi può aprire" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer öffnen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who can open"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién puede abrir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui peut ouvrir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開ける人"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谁可以打开"
          }
        }
      }
    },
    "Chi può aprirlo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer es öffnen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who can open it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién puede abrirlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui peut l'ouvrir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開ける人"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谁可以打开它"
          }
        }
      }
    },
    "Chi vuole mandarti un archivio XIZ usa la tua chiave pubblica (xizpk1…): solo tu potrai aprire le cartelle destinate a te." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dir ein XIZ-Archiv zu senden, verwenden andere deinen öffentlichen Schlüssel (xizpk1…): Nur du kannst die für dich bestimmten Ordner öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To send you an XIZ archive, people use your public key (xizpk1…): only you can open the folders meant for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para enviarte un archivo XIZ, otras personas usan tu clave pública (xizpk1…): solo tú podrás abrir las carpetas destinadas a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous envoyer une archive XIZ, on utilise votre clé publique (xizpk1…) : vous seul pourrez ouvrir les dossiers qui vous sont destinés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XIZアーカイブをあなたに送るには、あなたの公開鍵（xizpk1…）を使用します。あなた宛てのフォルダを開けるのはあなただけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他人要向你发送 XIZ 归档，需使用你的公钥（xizpk1…）：只有你才能打开发给你的文件夹。"
          }
        }
      }
    },
    "Chi vuole mandarti un archivio XIZ usa la tua chiave pubblica: solo tu potrai aprire le cartelle destinate a te. Le identità post-quantum (xizpq1…) resistono anche ai computer quantistici futuri; chi ti manda l'archivio deve avere Xipper 3.0 o successivo. Le classiche (xizpk1…) funzionano con tutte le versioni." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dir ein XIZ-Archiv zu senden, verwenden andere deinen öffentlichen Schlüssel: Nur du kannst die für dich bestimmten Ordner öffnen. Post-Quanten-Identitäten (xizpq1…) widerstehen auch künftigen Quantencomputern; der Absender braucht Xipper 3.0 oder neuer. Klassische (xizpk1…) funktionieren mit allen Versionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To send you an XIZ archive, people use your public key: only you can open the folders meant for you. Post-quantum identities (xizpq1…) also resist future quantum computers; the sender needs Xipper 3.0 or later. Classic ones (xizpk1…) work with every version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para enviarte un archivo XIZ, otras personas usan tu clave pública: solo tú podrás abrir las carpetas destinadas a ti. Las identidades poscuánticas (xizpq1…) resisten también a los futuros ordenadores cuánticos; quien envía necesita Xipper 3.0 o posterior. Las clásicas (xizpk1…) funcionan con todas las versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous envoyer une archive XIZ, on utilise votre clé publique : vous seul pourrez ouvrir les dossiers qui vous sont destinés. Les identités post-quantiques (xizpq1…) résistent aussi aux futurs ordinateurs quantiques ; l'expéditeur doit avoir Xipper 3.0 ou ultérieur. Les classiques (xizpk1…) fonctionnent avec toutes les versions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XIZアーカイブをあなたに送るには、相手があなたの公開鍵を使います。あなた宛てのフォルダを開けるのはあなただけです。ポスト量子ID（xizpq1…）は将来の量子コンピュータにも耐えます。送信者には Xipper 3.0 以降が必要です。従来型（xizpk1…）はすべてのバージョンで使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他人要向你发送 XIZ 归档，需要使用你的公钥：只有你能打开发给你的文件夹。后量子身份（xizpq1…）也能抵御未来的量子计算机；发送者需要 Xipper 3.0 或更高版本。传统身份（xizpk1…）适用于所有版本。"
          }
        }
      }
    },
