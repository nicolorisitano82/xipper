    "L'archivio contiene dati di recupero: «Ripara» ricostruisce le parti danneggiate, se il danno non supera la ridondanza." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv enthält Wiederherstellungsdaten: „Reparieren“ stellt die beschädigten Teile wieder her, sofern der Schaden die Redundanz nicht übersteigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive contains recovery data: “Repair” rebuilds the damaged parts, if the damage does not exceed the redundancy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido contiene datos de recuperación: «Reparar» reconstruye las partes dañadas, siempre que el daño no supere la redundancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive contient des données de récupération : « Réparer » reconstruit les parties endommagées, si les dégâts ne dépassent pas la redondance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブにはリカバリデータが含まれています：損傷が冗長性を超えていなければ、「修復」で損傷した部分を再構築できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档包含恢复数据：只要损坏程度不超过冗余量，“修复”即可重建损坏的部分。"
          }
        }
      }
    },
    "L'archivio non è firmato: nessuno garantisce per questa prova." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv ist nicht signiert: Niemand bürgt für diesen Nachweis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is not signed: nobody vouches for this proof."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido no está firmado: nadie garantiza esta prueba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive n'est pas signée : personne ne garantit cette preuve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブは署名されていません：この証明を保証する人はいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档未签名：没有人为此证明担保。"
          }
        }
      }
    },
    "L'archivio viene da Internet: i file estratti restano in quarantena e Gatekeeper li controllerà alla prima apertura." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv stammt aus dem Internet: Entpackte Dateien bleiben unter Quarantäne und Gatekeeper prüft sie beim ersten Öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive comes from the Internet: extracted files stay quarantined and Gatekeeper will check them the first time they are opened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido procede de Internet: los archivos extraídos se quedan en cuarentena y Gatekeeper los comprobará la primera vez que se abran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive provient d'Internet : les fichiers extraits restent en quarantaine et Gatekeeper les vérifiera à la première ouverture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブはインターネットから取得されたものです：展開されたファイルは検疫されたままになり、初めて開くときにGatekeeperが確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该归档来自互联网：解压出的文件将保持隔离状态，Gatekeeper 会在首次打开时检查它们。"
          }
        }
      }
    },
    "L'archivio viene modificato. L'operazione non si può annullare." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv wird geändert. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is changed. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se modificará el archivo comprimido. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive est modifiée. Cette opération est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブが変更されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档将被更改。此操作无法撤销。"
          }
        }
      }
    },
    "L'archivio è già aggiornato." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv ist bereits aktuell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is already up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo ya está actualizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive est déjà à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブはすでに最新です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档已是最新。"
          }
        }
      }
    },
    "L'archivio è un unico flusso compresso: i dati dopo il punto danneggiato non sono recuperabili." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Archiv ist ein einziger komprimierter Datenstrom: Die Daten nach der beschädigten Stelle können nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is a single compressed stream: the data after the damaged point cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo comprimido es un único flujo comprimido: los datos posteriores al punto dañado no se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archive est un flux compressé unique : les données situées après le point endommagé ne sont pas récupérables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブは単一の圧縮ストリームです：損傷した箇所以降のデータは復元できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该归档是单一压缩流：损坏点之后的数据无法恢复。"
          }
        }
      }
    },
    "L'ho eliminata. Riprova più tardi o scaricala dalla pagina del rilascio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe die Datei gelöscht. Versuche es später erneut oder lade sie von der Release-Seite herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I deleted it. Try again later or download it from the release page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La he eliminado. Vuelve a intentarlo más tarde o descárgala desde la página de la versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je l'ai supprimée. Réessayez plus tard ou téléchargez-la depuis la page de la version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除しました。あとでもう一度試すか、リリースページからダウンロードしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已将其删除。请稍后重试，或从发布页面下载。"
          }
        }
      }
    },
    "L'immagine scaricata non corrisponde all'impronta SHA-256 del rilascio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geladene Image stimmt nicht mit der SHA-256-Prüfsumme des Release überein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The downloaded image does not match the release's SHA-256 checksum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen descargada no coincide con la suma SHA-256 de la versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'image téléchargée ne correspond pas à l'empreinte SHA-256 de la version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたイメージがリリースのSHA-256チェックサムと一致しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的映像与发布版本的 SHA-256 校验和不匹配。"
          }
        }
      }
    },
    "L'originale non viene modificato: il nuovo archivio prende il suo nome solo dopo la verifica." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original wird nicht geändert: Das neue Archiv erhält seinen Namen erst nach der Prüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original is not changed: the new archive gets its name only after it is verified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El original no se modifica: el nuevo archivo comprimido recibe su nombre solo después de la verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'original n'est pas modifié : la nouvelle archive ne prend son nom qu'après vérification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルは変更されません：新しいアーカイブは検証後に元の名前になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原件不会被更改：新归档只有在验证后才会使用其名称。"
          }
        }
      }
    },
    "L'originale non è stato modificato." : {
      "localizations" : {
