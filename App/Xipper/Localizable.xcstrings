    "Xipper non scrive mai fuori dalla cartella di destinazione, non segue collegamenti durante l'estrazione e rimuove i permessi setuid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipper schreibt nie außerhalb des Zielordners, folgt beim Entpacken keinen Links und entfernt setuid-Rechte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipper never writes outside the destination folder, does not follow links while extracting and removes setuid permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipper nunca escribe fuera de la carpeta de destino, no sigue enlaces durante la extracción y elimina los permisos setuid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipper n'écrit jamais en dehors du dossier de destination, ne suit pas les liens pendant l'extraction et supprime les autorisations setuid."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipperは展開先フォルダの外に書き込むことはなく、展開中にリンクをたどらず、setuidアクセス権を削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xipper 绝不会写入目标文件夹之外，解压时不跟随链接，并会移除 setuid 权限。"
          }
        }
      }
    },
    "Xipper è aggiornato." : {
