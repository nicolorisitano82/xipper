    "Non potrai più firmare con questa chiave; le firme già fatte restano valide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mit diesem Schlüssel nicht mehr signieren; bereits erstellte Signaturen bleiben gültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will no longer be able to sign with this key; signatures already made stay valid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podrás firmar con esta clave; las firmas ya realizadas siguen siendo válidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez plus signer avec cette clé ; les signatures déjà faites restent valides."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この鍵で署名できなくなります。すでに作成された署名は有効なままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将无法再使用此密钥签名；已有的签名仍然有效。"
          }
        }
      }
    },
