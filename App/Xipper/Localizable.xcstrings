    "Sembra un file .%@ ma è un .%@, che si apre come programma." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht aus wie eine .%@-Datei, ist aber eine .%@-Datei, die als Programm geöffnet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like a .%@ file but is a .%@, which opens as a program."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece un archivo .%@, pero es un .%@, que se abre como un programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressemble à un fichier .%@ mais c'est un .%@, qui s'ouvre comme un programme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sembra un file .%1$@ ma è un .%2$@, che si apre come programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".%@ファイルに見えますが、実際はプログラムとして開く.%@です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来像 .%@ 文件，但实际是 .%@，它会作为程序打开。"
          }
        }
      }
    },
    "Sempre attivo, non si può disattivare." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer aktiv, kann nicht deaktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always on, cannot be turned off."
          }
        },
        "es" : {
