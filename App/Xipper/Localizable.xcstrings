    "“%@” pesa %@ ma dichiara %@ di dati estratti. Potrebbe essere una zip-bomb, pensata per riempire il disco." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist %2$@ groß, gibt aber %3$@ entpackte Daten an. Es könnte eine Zip-Bombe sein, die die Festplatte füllen soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is %2$@ but declares %3$@ of extracted data. It could be a zip bomb, meant to fill up the disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» ocupa %2$@ pero declara %3$@ de datos extraídos. Podría ser una bomba ZIP, pensada para llenar el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » pèse %2$@ mais déclare %3$@ de données extraites. Il pourrait s'agir d'une bombe ZIP, conçue pour remplir le disque."
          }
        },
