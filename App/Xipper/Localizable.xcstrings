            "state" : "translated",
            "value" : "Ein Apple-Archiv kann signiert oder passwortgeschützt sein, nicht beides"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Apple Archive can be signed or password-protected, not both"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Apple Archive puede estar firmado o protegido con contraseña, pero no ambas cosas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une Apple Archive peut être signée ou protégée par mot de passe, mais pas les deux"
