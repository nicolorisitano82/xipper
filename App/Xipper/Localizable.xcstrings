        }
      }
    },
    "La prova dimostra che questo file fa parte dell'archivio firmato, senza consegnare il resto." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nachweis zeigt, dass diese Datei Teil des signierten Archivs ist, ohne den Rest herauszugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The proof shows that this file is part of the signed archive, without handing over the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba demuestra que este archivo forma parte del archivo comprimido firmado, sin entregar el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La preuve montre que ce fichier fait partie de l'archive signée, sans remettre le reste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この証明は、残りの内容を渡すことなく、このファイルが署名付きアーカイブの一部であることを示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该证明可表明此文件属于已签名的归档，而无需交出其余内容。"
          }
        }
      }
    },
    "La scarico nei Download; poi la apro e Xipper si chiude, così lo trascini in Applicazioni al posto di questa copia." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich lade es in „Downloads“; dann öffne ich es und Xipper wird beendet, damit du es anstelle dieser Kopie in „Programme“ ziehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download it to Downloads; then I open it and Xipper quits, so you can drag it into Applications in place of this copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descargo en Descargas; luego la abro y Xipper se cierra, para que puedas arrastrarlo a Aplicaciones en lugar de esta copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je la télécharge dans Téléchargements ; puis je l'ouvre et Xipper se ferme, pour que vous puissiez le faire glisser dans Applications à la place de cette copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ダウンロード”にダウンロードします。そのあと開くとXipperが終了するので、このコピーの代わりに“アプリケーション”にドラッグしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会将其下载到“下载”文件夹；然后打开它并退出 Xipper，这样你就可以将它拖到“应用程序”中替换此副本。"
          }
        }
      }
    },
    "La verifica periodica ha trovato e riparato dei danni in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die regelmäßige Prüfung hat Schäden in %@ gefunden und repariert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The periodic check found and repaired damage in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprobación periódica ha encontrado y reparado daños en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification périodique a détecté et réparé des dégâts dans %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期チェックで%@の損傷が見つかり、修復されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期检查在 %@ 中发现并修复了损坏。"
          }
        }
      }
    },
    "La versione attuale resta disponibile in «Versioni»." : {
