          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la versión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez la version %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン%@を使用しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你使用的是版本 %@。"
          }
        }
      }
    },
    "Hai modificato il volume montato. Xipper ricostruisce l'archivio con le modifiche e sostituisce l'originale solo quando il nuovo è completo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das aktivierte Volume geändert. Xipper erstellt das Archiv mit deinen Änderungen neu und ersetzt das Original erst, wenn das neue vollständig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You changed the mounted volume. Xipper rebuilds the archive with your changes and replaces the original only once the new one is complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has modificado el volumen montado. Xipper reconstruye el archivo comprimido con los cambios y sustituye el original solo cuando el nuevo está completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez modifié le volume monté. Xipper reconstruit l'archive avec vos modifications et ne remplace l'original qu'une fois la nouvelle terminée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウントされたボリュームを変更しました。Xipperは変更を反映してアーカイブを再構築し、新しいアーカイブが完成してから元のアーカイブを置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你更改了已装载的宗卷。Xipper 会使用你的更改重建归档，并仅在新归档完整后才替换原件。"
          }
        }
      }
    },
    "Ho capito cosa si perde" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verstehe, was verloren geht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand what will be lost"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo lo que se pierde"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai compris ce qui sera perdu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失われるものを理解しました"
