    "Per le cartelle custodite, ogni custode inserisce la propria password su questo Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Ordnern in der Obhut von Treuhändern gibt jeder Treuhänder sein eigenes Passwort auf diesem Mac ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For folders held by custodians, each custodian types their own password on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las carpetas con custodios, cada custodio introduce su propia contraseña en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les dossiers confiés à des dépositaires, chaque dépositaire saisit son propre mot de passe sur ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管者が保持するフォルダの場合は、各保管者がこのMacで自分のパスワードを入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于由保管人持有的文件夹，每位保管人在此 Mac 上输入各自的密码。"
          }
        }
      }
    },
