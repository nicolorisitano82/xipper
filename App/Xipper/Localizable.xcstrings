    "In background rilegge ogni archivio creato o protetto da Xipper e ripara da solo i danni che i dati di recupero coprono. Archivi seguiti: %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest im Hintergrund jedes von Xipper erstellte oder geschützte Archiv erneut und repariert selbstständig alle Schäden, die die Wiederherstellungsdaten abdecken. Überwachte Archive: %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the background, rereads every archive Xipper created or protected and repairs on its own any damage the recovery data covers. Archives followed: %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En segundo plano, vuelve a leer cada archivo comprimido creado o protegido por Xipper y repara por sí solo los daños que cubren los datos de recuperación. Archivos supervisados: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En arrière-plan, relit chaque archive créée ou protégée par Xipper et répare automatiquement les dégâts couverts par les données de récupération. Archives suivies : %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドで、Xipperが作成または保護したすべてのアーカイブを読み直し、リカバリデータでカバーされる損傷を自動的に修復します。監視中のアーカイブ：%lld。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台重新读取 Xipper 创建或保护的每个归档，并自动修复恢复数据所能覆盖的损坏。已跟踪的归档：%lld。"
          }
        }
      }
    },
