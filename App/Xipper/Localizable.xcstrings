    "SHA-256 è il più diffuso; BLAKE3 è il più veloce tra quelli sicuri; XXH128 è velocissimo ma rileva solo i danni accidentali." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 ist am weitesten verbreitet; BLAKE3 ist der schnellste unter den sicheren; XXH128 ist sehr schnell, erkennt aber nur versehentliche Schäden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 is the most widespread; BLAKE3 is the fastest of the secure ones; XXH128 is very fast but only detects accidental damage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 es el más extendido; BLAKE3 es el más rápido de los seguros; XXH128 es rapidísimo, pero solo detecta daños accidentales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 est le plus répandu ; BLAKE3 est le plus rapide parmi les algorithmes sûrs ; XXH128 est très rapide mais ne détecte que les dégâts accidentels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256は最も広く使われています。BLAKE3は安全なアルゴリズムの中で最も高速です。XXH128は非常に高速ですが、偶発的な損傷しか検出できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHA-256 最为普及；BLAKE3 是安全算法中最快的；XXH128 速度极快，但只能检测意外损坏。"
          }
        }
      }
    },
