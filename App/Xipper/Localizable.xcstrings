    "Le cartelle di un gruppo di custodi si aprono solo quando il numero richiesto di custodi sblocca insieme; nessuno può farlo da solo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ordner einer Treuhändergruppe öffnen sich nur, wenn die erforderliche Anzahl an Treuhändern gemeinsam entsperrt; niemand kann es allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folders of a custodian group open only when the required number of custodians unlock together; nobody can do it alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas de un grupo de custodios solo se abren cuando el número requerido de custodios las desbloquea a la vez; nadie puede hacerlo solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers d'un groupe de dépositaires ne s'ouvrent que lorsque le nombre requis de dépositaires les déverrouillent ensemble ; personne ne peut le faire seul."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管者グループのフォルダは、必要な人数の保管者が共同でロックを解除したときにのみ開きます。1人だけでは開けません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管人组的文件夹只有在所需数量的保管人共同解锁时才能打开；任何人都无法单独打开。"
          }
        }
      }
    },
