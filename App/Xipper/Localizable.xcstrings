    "Aggiunge i file nuovi o cambiati e toglie quelli che non ci sono più, in una nuova versione" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt neue oder geänderte Dateien hinzu und entfernt nicht mehr vorhandene, in einer neuen Version"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds new or changed files and removes those that are gone, in a new version"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los archivos nuevos o cambiados y quita los que ya no están, en una nueva versión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute les fichiers nouveaux ou modifiés et supprime ceux qui n'existent plus, dans une nouvelle version"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
