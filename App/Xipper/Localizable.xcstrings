    "Se esci ora verranno annullati. Gli archivi incompleti non vengono lasciati sul disco." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du jetzt beendest, werden sie abgebrochen. Unvollständige Archive bleiben nicht auf der Festplatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you quit now they will be cancelled. Incomplete archives are not left on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales ahora, se cancelarán. Los archivos comprimidos incompletos no se dejan en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous quittez maintenant, elles seront annulées. Les archives incomplètes ne sont pas laissées sur le disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今終了すると、これらはキャンセルされます。不完全なアーカイブはディスクに残りません。"
