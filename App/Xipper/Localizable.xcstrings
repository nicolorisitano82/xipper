    "%@ letture su %lld sequenze di riferimento. Per leggerle, convertilo in BAM con il riferimento FASTA usato per scriverlo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Reads auf %lld Referenzsequenzen. Um sie zu lesen, konvertiere die Datei mit der Referenz-FASTA, mit der sie geschrieben wurde, in BAM."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reads on %lld reference sequences. To read them, convert it to BAM with the reference FASTA it was written with."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lecturas en %2$lld secuencias de referencia. Para leerlas, conviértelo a BAM con el FASTA de referencia con el que se escribió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lectures sur %2$lld séquences de référence. Pour les lire, convertissez-le en BAM avec le FASTA de référence utilisé pour l'écrire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ letture su %2$lld sequenze di riferimento. Per leggerle, convertilo in BAM con il riferimento FASTA usato per scriverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@リード、参照配列%lld本。読み込むには、書き込み時に使用された参照FASTAでBAMに変換してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 条读段，位于 %lld 条参考序列上。要读取它们，请使用写入时所用的参考 FASTA 将其转换为 BAM。"
          }
        }
      }
    },
