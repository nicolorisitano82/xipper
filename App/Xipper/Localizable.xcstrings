        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我了解将会丢失哪些内容"
          }
        }
      }
    },
    "I dati di recupero %@ valgono solo per l'originale" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellungsdaten %@ schützen nur das Original"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recovery data %@ only protects the original"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de recuperación %@ solo sirven para el original"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de récupération %@ ne protègent que l'original"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリデータ%@は元のファイルのみを保護します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复数据 %@ 仅保护原件"
          }
        }
      }
    },
    "I dati di recupero non bastano a riparare %@. Fanne una nuova copia da un'altra fonte, se ce l'hai." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellungsdaten reichen nicht aus, um %@ zu reparieren. Erstelle eine neue Kopie aus einer anderen Quelle, falls vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recovery data is not enough to repair %@. Make a new copy from another source, if you have one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de recuperación no bastan para reparar %@. Haz una copia nueva desde otra fuente, si la tienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de récupération ne suffisent pas à réparer %@. Faites-en une nouvelle copie depuis une autre source, si vous en avez une."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリデータが不足しているため%@を修復できません。別のソースがあれば、そこから新しいコピーを作成してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复数据不足以修复 %@。如果你有其他来源，请重新拷贝一份。"
          }
        }
      }
    },
    "I file passano direttamente nel nuovo archivio, senza essere estratti su disco" : {
