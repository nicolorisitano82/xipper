    "Usalo solo se chi riceve ha un programma che non supporta AES. 7-Zip, WinRAR, Keka e Xipper aprono gli archivi AES-256." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende es nur, wenn der Empfänger ein Programm ohne AES-Unterstützung hat. 7-Zip, WinRAR, Keka und Xipper öffnen AES-256-Archive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use it only if the recipient has a program without AES support. 7-Zip, WinRAR, Keka and Xipper open AES-256 archives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo solo si el destinatario tiene un programa que no admite AES. 7-Zip, WinRAR, Keka y Xipper abren los archivos AES-256."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez-le uniquement si le destinataire a un programme sans prise en charge d'AES. 7-Zip, WinRAR, Keka et Xipper ouvrent les archives AES-256."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信者がAESに対応していないプログラムを使用している場合にのみ使用してください。7-Zip、WinRAR、Keka、XipperはAES-256アーカイブを開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当收件人使用的程序不支持 AES 时才使用。7-Zip、WinRAR、Keka 和 Xipper 都能打开 AES-256 归档。"
          }
        }
      }
    },
